    "fly": "fly --app kimaki-gateway-production",
    "deployment": "tsx scripts/deployment.ts"
  },
  "dependencies": {
    "@xmorse/deployment-utils": "^0.7.4",
    "discord.js": "^14.25.1"
  },
  "devDependencies": {
